{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vela",
  "version": "0.0.1",
  "identifier": "app.vela.m1",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vela",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE4RjNBOEIzQjA5RTMxNUIKUldUcGJhL0dFZGtKVEhKNzBMK0xPckJPNzJxVGdXNnNFMHlFRmRLMVRvZnpPMWRDNVhKZjRqYWwK",
      "endpoints": [
        "https://vela-updates.example.com/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  }
}
